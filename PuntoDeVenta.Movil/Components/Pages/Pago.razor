@page "/pago"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using PuntoDeVenta.Movil.DTOs
@using PuntoDeVenta.Movil.Servicios
@attribute [Authorize(Roles = "Cliente")]
@inject HttpClient Http
@inject CarritoService Carrito

<MudText Typo="Typo.h5" Class="mb-3">Finalizar compra</MudText>

@if (compraId is not null)
{
    @* Compra confirmada *@
    <MudAlert Severity="Severity.Success" Class="mb-3">
        <MudText Typo="Typo.h6">¡Pago aprobado!</MudText>
        <MudText>Tu compra es la número <b>@compraId</b>.</MudText>
        <MudText>Total pagado: <b>@Formato.Dinero(totalPagado)</b></MudText>
    </MudAlert>
    <MudButton Href="/mis-compras" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mb-2">Ver mis compras</MudButton>
    <MudButton Href="/catalogo" Variant="Variant.Outlined" FullWidth="true">Volver al catálogo</MudButton>
}
else if (Carrito.Items.Count == 0)
{
    <MudText Class="mb-3">Tu carrito está vacío.</MudText>
    <MudButton Href="/catalogo" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Ir al catálogo</MudButton>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-1">Resumen</MudText>
    <MudPaper Class="pa-3 mb-3">
        @foreach (var item in Carrito.Items)
        {
            <div class="d-flex justify-space-between mb-1">
                <span>@item.Cantidad × @item.Producto.Nombre</span>
                <span>@Formato.Dinero(item.Subtotal)</span>
            </div>
        }
        <MudDivider Class="my-2" />
        <div class="d-flex justify-space-between">
            <b>Total</b>
            <b>@Formato.Dinero(Carrito.Total)</b>
        </div>
    </MudPaper>

    <MudSelect T="string" @bind-Value="metodoPago" Label="Forma de pago" Variant="Variant.Outlined"
               Disabled="@procesando" HelperText="Pago simulado: no se realiza ningún cobro real.">
        <MudSelectItem T="string" Value="@("Tarjeta")">Tarjeta</MudSelectItem>
        <MudSelectItem T="string" Value="@("Transferencia")">Transferencia</MudSelectItem>
    </MudSelect>

    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-3 mb-2"
               Disabled="@procesando" OnClick="Pagar">
        @if (procesando)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Procesando pago...</span>
        }
        else
        {
            <span>Pagar @Formato.Dinero(Carrito.Total)</span>
        }
    </MudButton>
    <MudButton Href="/carrito" Variant="Variant.Outlined" FullWidth="true">Volver al carrito</MudButton>
}

@code {
    private string metodoPago = "Tarjeta";
    private string? error;
    private bool procesando;
    private int? compraId;
    private decimal totalPagado;

    private record CompraCreada(int Id);

    private async Task Pagar()
    {
        error = null;

        if (Carrito.Items.Count == 0)
        {
            error = "El carrito está vacío.";
            return;
        }

        procesando = true;
        try
        {
            await Task.Delay(1500);

            var compra = new CrearCompraDTO
            {
                MetodoPago = metodoPago,
                Detalles = Carrito.Items
                    .Select(i => new CrearSalidaDetalleDTO
                    {
                        ProductoId = i.Producto.Id,
                        Cantidad = i.Cantidad
                    })
                    .ToList()
            };

            var respuesta = await Http.PostAsJsonAsync("api/Tienda/compra", compra);

            if (!respuesta.IsSuccessStatusCode)
            {
                error = await respuesta.Content.ReadAsStringAsync();
                return;
            }

            var creada = await respuesta.Content.ReadFromJsonAsync<CompraCreada>();
            totalPagado = Carrito.Total;
            compraId = creada?.Id;
            Carrito.Vaciar();
        }
        catch (Exception ex)
        {
            error = $"No se pudo completar la compra: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}
