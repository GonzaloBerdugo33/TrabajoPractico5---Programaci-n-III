@page "/Login"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PuntoDeVenta.Movil.Auth
@using PuntoDeVenta.Movil.DTOs
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudCard Elevation="4" Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">Iniciar sesión</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField @bind-Value="loginDto.Email"
                      Label="Correo electrónico"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Class="mb-4" />

        <MudTextField @bind-Value="loginDto.Password"
                      Label="Contraseña"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password" />
    </MudCardContent>
    <MudCardActions Class="pa-4 flex-column">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@ingresando"
                   OnClick="HandleLogin">
            @(ingresando ? "Ingresando..." : "Ingresar")
        </MudButton>
        <MudButton Href="/registro" Variant="Variant.Text" FullWidth="true" Class="mt-2">
            No tengo cuenta, crear una
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    private LoginDTO loginDto = new();
    private bool ingresando;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginDto.Email) || string.IsNullOrWhiteSpace(loginDto.Password))
        {
            Snackbar.Add("Completá el correo y la contraseña.", Severity.Warning);
            return;
        }

        ingresando = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Usuario/Login", loginDto);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResultDTO>();

                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await SecureStorage.Default.SetAsync("authToken", result.Token);

                    ((CustomAuthStateProvider)AuthStateProvider).NotifyUserAuthentication(result.Token);

                    Snackbar.Add("¡Bienvenido!", Severity.Success);

                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
        finally
        {
            ingresando = false;
        }
    }
}
