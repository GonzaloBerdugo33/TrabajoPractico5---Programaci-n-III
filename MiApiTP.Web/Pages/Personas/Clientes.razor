@page "/Clientes"
@using MiApiTP.Web.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<h3 class="mb-3">👥 Administración de Clientes</h3>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-9">
        <input type="search"
               class="form-control"
               placeholder="Buscar cliente por nombre en tiempo real..."
               @bind="filtroBusqueda"
               @bind:event="oninput" />
    </div>
    <div class="col-md-3 text-end">
        <a href="/Clientes/Nuevo" class="btn btn-primary w-100">+ Nuevo Cliente</a>
    </div>
</div>

@if (clientesQueryable == null)
{
    <p><em>Cargando listado de clientes...</em></p>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@ClientesFiltrados" Pagination="@pagination" class="table table-hover align-middle mb-0">
            
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Id)" Title="ID" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Nombre)" Title="Nombre / Razón Social" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.DNI)" Title="DNI" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Telefono)" Title="Teléfono" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Email)" Title="Correo Electrónico" Sortable="true" />
            
            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Acciones" Context="cliente" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarCliente(cliente.Id)">
                    Eliminar
                </button>
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

        </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
    </div>

    <div class="mt-3 d-flex justify-content-center">
        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@pagination" />
    </div>
}

@code {
    private Microsoft.AspNetCore.Components.QuickGrid.PaginationState pagination = new() { ItemsPerPage = 10 };
    private string filtroBusqueda = string.Empty;
    
    private IQueryable<ListarClienteDTO>? clientesQueryable;

    private IQueryable<ListarClienteDTO> ClientesFiltrados
    {
        get
        {
            if (clientesQueryable == null)
                return Enumerable.Empty<ListarClienteDTO>().AsQueryable();

            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return clientesQueryable;

            return clientesQueryable.Where(c => c.Nombre.ToLower().Contains(filtroBusqueda.Trim().ToLower()));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<ListarClienteDTO>>("api/Cliente?pagina=1&tamanoPagina=1000");
            if (lista != null)
            {
                clientesQueryable = lista.AsQueryable();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar clientes: {ex.Message}", Severity.Error);
        }
    }

    private async Task EliminarCliente(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Cliente/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Cliente eliminado con éxito", Severity.Success);
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"No se pudo eliminar: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }
}