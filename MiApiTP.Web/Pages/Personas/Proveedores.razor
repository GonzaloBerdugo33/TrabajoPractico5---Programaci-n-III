@page "/Proveedores"
@using MiApiTP.Web.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<h3 class="mb-3">🏢 Administración de Proveedores</h3>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-9">

        <input type="search" 
               class="form-control" 
               placeholder="Buscar proveedor por razón social en tiempo real..." 
               @bind="filtroBusqueda" 
               @bind:event="oninput" />
    </div>
    <div class="col-md-3 text-end">
        <a href="/Proveedores/Nuevo" class="btn btn-primary w-100">+ Nuevo Proveedor</a>
    </div>
</div>

@if (proveedoresQueryable == null)
{
    <p><em>Cargando proveedores desde la API...</em></p>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@ProveedoresFiltrados" Pagination="@pagination" class="table table-hover align-middle mb-0">
            
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Id)" Title="ID" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.RazonSocial)" Title="Razón Social" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.CUIT)" Title="CUIT" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Telefono)" Title="Teléfono" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Email)" Title="Correo Electrónico" Sortable="true" />

            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Acciones" Context="prov" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProveedor(prov.Id)">
                    Eliminar
                </button>
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

        </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
    </div>

    <div class="mt-3 d-flex justify-content-center">
        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@pagination" />
    </div>
}

@code {
    private Microsoft.AspNetCore.Components.QuickGrid.PaginationState pagination = new() { ItemsPerPage = 10 };
    
    private string filtroBusqueda = string.Empty;
    
    private IQueryable<ListarProveedorDTO>? proveedoresQueryable;

    private IQueryable<ListarProveedorDTO> ProveedoresFiltrados
    {
        get
        {
            if (proveedoresQueryable == null)
                return Enumerable.Empty<ListarProveedorDTO>().AsQueryable();

            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return proveedoresQueryable;

            var termino = filtroBusqueda.Trim().ToLower();

            return proveedoresQueryable.Where(p => p.RazonSocial.ToLower().Contains(termino));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<ListarProveedorDTO>>("api/Proveedor?pagina=1&tamanoPagina=1000");
            if (lista != null)
            {
                proveedoresQueryable = lista.AsQueryable();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar proveedores: {ex.Message}", Severity.Error);
        }
    }

    private async Task EliminarProveedor(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Proveedor/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Proveedor eliminado con éxito.", Severity.Success);
                await CargarProveedores();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}