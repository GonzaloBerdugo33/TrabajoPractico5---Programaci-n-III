@page "/reportes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Reportes PDF</MudText>
<MudText Class="mb-4">Elegí el reporte que querés descargar.</MudText>

<div class="d-flex flex-wrap gap-3">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PictureAsPdf"
               Disabled="@(descargando != null)"
               OnClick="@(() => Descargar("stock"))">
        @(descargando == "stock" ? "Generando..." : "Reporte de stock")
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PictureAsPdf"
               Disabled="@(descargando != null)"
               OnClick="@(() => Descargar("entradas"))">
        @(descargando == "entradas" ? "Generando..." : "Reporte de entradas")
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PictureAsPdf"
               Disabled="@(descargando != null)"
               OnClick="@(() => Descargar("salidas"))">
        @(descargando == "salidas" ? "Generando..." : "Reporte de salidas")
    </MudButton>
</div>

@code {
    // Guarda cuál reporte se está generando (null = ninguno)
    private string? descargando;

    private async Task Descargar(string reporte)
    {
        descargando = reporte;

        try
        {
            var respuesta = await Http.GetAsync($"api/Reporte/{reporte}");

            if (!respuesta.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo generar el reporte.", Severity.Error);
                return;
            }

            var bytes = await respuesta.Content.ReadAsByteArrayAsync();
            var nombre = $"{reporte}-{DateTime.Now:yyyyMMdd}.pdf";

            await JS.InvokeVoidAsync("descargarArchivo", nombre, bytes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al descargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            descargando = null;
        }
    }
}