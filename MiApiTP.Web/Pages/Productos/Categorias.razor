@page "/Categoria"
@using Microsoft.AspNetCore.Authorization
@using MiApiTP.Web.DTOs
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar


<h3 class="mb-3">🏷️ Categorías de Productos</h3>

<div class="row mb-4 align-items-center">
    <div class="col-md-9">
        @* MudTextField se enlaza de forma bidireccional (@bind-Value) con la propiedad en memoria *@
        <MudTextField @bind-Value="nuevaCat.Nombre" 
                      Label="Escriba el nombre de la nueva categoría..." 
                      Variant="Variant.Outlined" 
                      Dense="true"/>
    </div>
    <div class="col-md-3">
        @* Al hacer clic, se dispara el método de C# 'AgregarCategoria' *@
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   FullWidth="true" 
                   Style="height: 40px;" 
                   OnClick="AgregarCategoria">
            Agregar Categoría
        </MudButton>
    </div>
</div>

@if (categoriasQueryable == null)
{
    @* Pantalla de carga temporal mientras esperamos la respuesta asíncrona de la API *@
    <p><em>Cargando categorías desde el servidor...</em></p>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@categoriasQueryable" Pagination="@pagination" class="table table-hover align-middle mb-0">
            
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Id)" Title="ID" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(c => c.Nombre)" Title="Nombre de Categoría" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Acciones" Context="cat" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarCategoria(cat.Id)">
                    Eliminar
                </button>
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

        </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
    </div>

    <div class="mt-3 d-flex justify-content-center">
        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@pagination" />
    </div>
}

@code {
    
    private Microsoft.AspNetCore.Components.QuickGrid.PaginationState pagination = new() { ItemsPerPage = 10 };
    private CategoriaProductoDTO nuevaCat = new();
    
    private IQueryable<CategoriaProductoDTO>? categoriasQueryable;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<CategoriaProductoDTO>>("api/CategoriaProducto");
            if (lista != null)
            {
                categoriasQueryable = lista.AsQueryable();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }

    private async Task AgregarCategoria()
    {
        if (string.IsNullOrWhiteSpace(nuevaCat.Nombre))
        {
            Snackbar.Add("El nombre de la categoría no puede estar vacío.", Severity.Warning);
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/CategoriaProducto", nuevaCat);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Categoría guardada con éxito!", Severity.Success);
                nuevaCat = new();
                await CargarCategorias();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo guardar: {ex.Message}", Severity.Error);
        }
    }

    private async Task EliminarCategoria(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/CategoriaProducto/{id}");
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Categoría eliminada del sistema.", Severity.Success);
                await CargarCategorias();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}