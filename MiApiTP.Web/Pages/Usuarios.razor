@page "/Usuarios"
@using MiApiTP.Web.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<h3 class="mb-3">👤 Administración de Usuarios</h3>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-9">
        <input type="search" 
               class="form-control" 
               placeholder="Buscar usuario por nombre o email en tiempo real..." 
               @bind="filtroBusqueda" 
               @bind:event="oninput" />
    </div>
    <div class="col-md-3 text-end">
        <a href="/Register" class="btn btn-primary w-100">+ Nuevo Usuario</a>
    </div>
</div>

@if (usuariosQueryable == null)
{
    <p><em>Cargando usuarios desde la API...</em></p>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@UsuariosFiltrados" Pagination="@pagination" class="table table-hover align-middle mb-0">
            
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(u => u.Id)" Title="ID" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(u => u.Nombre)" Title="Nombre" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(u => u.Email)" Title="Correo Electrónico" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(u => u.Rol)" Title="Rol" Sortable="true" />

            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="Acciones" Context="user" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarUsuario(user.Id)">
                    Eliminar
                </button>
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

        </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
    </div>

    <div class="mt-3 d-flex justify-content-center">
        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@pagination" />
    </div>
}

@code {
    private Microsoft.AspNetCore.Components.QuickGrid.PaginationState pagination = new() { ItemsPerPage = 10 };
    
    private string filtroBusqueda = string.Empty;
    
    private IQueryable<UsuarioDTO>? usuariosQueryable;

    private IQueryable<UsuarioDTO> UsuariosFiltrados
    {
        get
        {
            if (usuariosQueryable == null)
                return Enumerable.Empty<UsuarioDTO>().AsQueryable();

            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return usuariosQueryable;

            var termino = filtroBusqueda.Trim().ToLower();

            return usuariosQueryable.Where(u => u.Nombre.ToLower().Contains(termino) || u.Email.ToLower().Contains(termino));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        try
        {

            var lista = await Http.GetFromJsonAsync<List<UsuarioDTO>>("api/Usuario");
            if (lista != null)
            {
                usuariosQueryable = lista.AsQueryable();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar usuarios: {ex.Message}", Severity.Error);
        }
    }

    private async Task EliminarUsuario(int id)
    {
        try
        {
            // Ajustá la URL "api/Usuario/{id}" según tu controlador de la API
            var response = await Http.DeleteAsync($"api/Usuario/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Usuario eliminado con éxito.", Severity.Success);
                await CargarUsuarios();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
        }
    }
}