@page "/Productos-grid"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MiApiTP.Web.DTOs
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Catálogo de Productos</h3>

    @* Solo el administrador ve el botón de alta *@
    @if (esAdmin)
    {
        <a href="/Productos/Nuevo" class="btn btn-primary">+ Nuevo producto</a>
    }
</div>

<!-- Barra de herramientas: Búsqueda y configuración de página -->
<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-6">
        <input type="search"
               class="form-control"
               placeholder="Buscar producto por nombre o categoría..."
               @bind="filtroBusqueda"
               @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <div class="input-group">
            <label class="input-group-text">Por pág.</label>
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="20">20</option>
            </select>
        </div>
    </div>
</div>

@if (productosQueryable == null)
{
    <p><em>Cargando catálogo desde la API...</em></p>
}
else
{
    <div class="table-responsive shadow-sm border rounded">
        @* RowClass: si el stock es 0, la fila se ve atenuada (producto "desactivado") *@
        <Microsoft.AspNetCore.Components.QuickGrid.QuickGrid Items="@ProductosFiltrados"
                                                             Pagination="@pagination"
                                                             RowClass="@(p => p.Stock == 0 ? "opacity-50" : null)"
                                                             class="table table-hover align-middle mb-0">

            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="ProductoDTO" Title="Foto" Context="prod">
                @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                {
                    <img src="@prod.ImagenUrl"
                         alt="@prod.Nombre"
                         style="width: 45px; height: 45px; object-fit: contain;"
                         class="rounded border bg-white p-1" />
                }
                else
                {
                    <span class="badge bg-light text-muted border">S/I</span>
                }
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Id)" Title="ID" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Nombre)" Title="Producto" Sortable="true" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.CategoriaNombre)" Title="Categoría" Sortable="true" />

            @* El proveedor solo lo ve el administrador *@
            @if (esAdmin)
            {
                <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.ProveedorNombre)" Title="Proveedor" Sortable="true" />
            }

            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Precio)" Title="Precio ($)" Format="C2" Sortable="true" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Right" />
            <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn Property="@(p => p.Stock)" Title="Stock" Sortable="true" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Right" />

            <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="ProductoDTO" Title="Estado" Context="prod" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                @if (prod.Stock == 0)
                {
                    <span class="badge bg-secondary">Agotado</span>
                }
                else
                {
                    <span class="badge bg-success">Disponible</span>
                }
            </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

            @* Columna de acciones: solo para el administrador *@
            @if (esAdmin)
            {
                <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="ProductoDTO" Title="Acciones" Context="prod" Align="Microsoft.AspNetCore.Components.QuickGrid.Align.Center">
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProducto(prod)">
                        Eliminar
                    </button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ActualizarProducto(prod)">
                        Actualizar
                    </button>
                </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
            }
        </Microsoft.AspNetCore.Components.QuickGrid.QuickGrid>
    </div>

    <!-- Navegador de Páginas nativo de QuickGrid -->
    <div class="mt-3 d-flex justify-content-center">
        <Microsoft.AspNetCore.Components.QuickGrid.Paginator State="@pagination" />
    </div>
}

@code {
    private Microsoft.AspNetCore.Components.QuickGrid.PaginationState pagination = new() { ItemsPerPage = 5 };
    private string filtroBusqueda = string.Empty;
    private IQueryable<ProductoDTO>? productosQueryable;
    private bool esAdmin = false;

    private IQueryable<ProductoDTO> ProductosFiltrados
    {
        get
        {
            if (productosQueryable == null)
                return Enumerable.Empty<ProductoDTO>().AsQueryable();

            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return productosQueryable;

            var termino = filtroBusqueda.Trim().ToLower();
            return productosQueryable.Where(p =>
                p.Nombre.ToLower().Contains(termino) ||
                (p.CategoriaNombre != null && p.CategoriaNombre.ToLower().Contains(termino)) ||
                (p.ProveedorNombre != null && p.ProveedorNombre.ToLower().Contains(termino)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // ¿Quien está mirando la página es administrador?
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        esAdmin = estado.User.IsInRole("Administrador");

        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            // tamanoPagina grande: la API pagina de a 10 por defecto y el catálogo debe traer todos
            var lista = await Http.GetFromJsonAsync<List<ProductoDTO>>("api/Producto?pagina=1&tamanoPagina=1000");
            productosQueryable = (lista ?? new()).AsQueryable();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el catálogo: {ex.Message}", Severity.Error);
        }
    }

    private void ActualizarProducto(ProductoDTO prod)
    {
        Navigation.NavigateTo($"/Productos/Actualizar/{prod.Id}");
    }

    private async Task EliminarProducto(ProductoDTO prod)
    {
        // confirm() es el cuadro de confirmación del navegador
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el producto '{prod.Nombre}'?");
        if (!confirmar) return;

        try
        {
            var response = await Http.DeleteAsync($"api/Producto/{prod.Id}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto eliminado.", Severity.Success);
                await CargarProductos();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"No se pudo eliminar: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }
}
